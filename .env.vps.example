# =========================
# OpenWA VPS Environment
# =========================
NODE_ENV=production
LOG_LEVEL=info
PORT=2785

# Public URLs
BASE_URL=https://openwa-api.autoviseo.com
DASHBOARD_URL=https://openwa-panel.autoviseo.com

# Strict origin allowlists (no wildcard)
CORS_ORIGINS=https://openwa-panel.autoviseo.com
WS_ALLOWED_ORIGINS=https://openwa-panel.autoviseo.com

# Traefik docker network name (must already exist on VPS)
TRAEFIK_NETWORK=traefik-public

# Dashboard protection (required)
# Generate with: htpasswd -nbB admin 'CHANGE_ME_STRONG_PASSWORD'
DASHBOARD_BASIC_AUTH_USERS=admin:$2y$05$REPLACE_WITH_BCRYPT_HASH
# Optional if using IP allowlist middleware instead of basic auth
DASHBOARD_ALLOWLIST_CIDRS=203.0.113.10/32,198.51.100.0/24

# Database (PostgreSQL preferred)
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Redis (optional)
REDIS_ENABLED=false
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_OR_EMPTY

# Webhook controls
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000

# Engine/storage
ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=/app/data/sessions
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data/media

# API authentication
# Keep blank unless you explicitly use it; primary auth is API key entities in DB
API_MASTER_KEY=

# Suggested n8n target for your webhook records (per-session in app UI/API)
N8N_WEBHOOK_URL=https://flow.autoviseo.cloud/webhook/openwa-incoming
